{
  // Settings that I actually touch
  "editor.fontFamily": "Geist Mono",
  "editor.fontSize": 13,
  "terminal.integrated.fontFamily": "GeistMono Nerd Font",
  "terminal.integrated.fontSize": 12,
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.colorTheme": "Ayu Dark",
  // That's about it
  "[csharp]": {
    "editor.defaultFormatter": "csharpier.csharpier-vscode",
    "editor.rulers": [120],
    "editor.tabSize": 4,
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },
  "[prisma]": {
    "editor.tabSize": 2,
    "editor.defaultFormatter": "Prisma.prisma",
  },
  "[python]": {
    "editor.defaultFormatter": "ms-python.python",
    "editor.tabSize": 4,
  },
  "[rust]": {
    "editor.tabSize": 4,
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
  },
  "[sql]": {
    "editor.defaultFormatter": "adpyke.vscode-sql-formatter",
    "editor.tabSize": 4,
    "editor.rulers": [100],
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },
  "[vue]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2,
  },
  "breadcrumbs.enabled": true,
  "breadcrumbs.icons": false,
  "colorize.colorized_variables": ["CSS", "SASS"],
  "cSpell.userWords": [
    "burk",
    "camelcase",
    "catppuccin",
    "dropzone",
    "edamam",
    "ghostty",
    "jsonify",
    "linaria",
    "luxon",
    "millis",
    "nextjs",
    "pacamara",
    "percburk",
    "postgres",
    "Pressable",
    "rgba",
    "snackbars",
    "Swipeable",
    "tailwindcss",
    "tanstack",
    "trivago",
    "trpc",
  ],
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.bracketPairColorization.enabled": false,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
  },
  "editor.cursorBlinking": "smooth",
  "editor.detectIndentation": false,
  "editor.fontLigatures": false,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": false,
  "editor.hover.delay": 1000,
  "editor.insertSpaces": true,
  "editor.linkedEditing": true,
  "editor.minimap.autohide": "scroll",
  "editor.minimap.enabled": true,
  "editor.quickSuggestions": { "strings": true },
  "editor.smoothScrolling": true,
  "editor.snippetSuggestions": "top",
  "errorLens.delay": 3000,
  "errorLens.excludeByMessage": [
    "unknown word.",
    "is assigned a value but never used.",
    "import should occur before import of",
  ],
  "errorLens.fontSize": "-2px",
  "errorLens.messageBackgroundMode": "none",
  "explorer.compactFolders": false,
  "explorer.expandSingleFolderWorkspaces": false,
  "files.associations": {
    "*.esproj": "xml",
    ".env.staging": "properties",
    ".env.demo": "properties",
    ".env.production": "properties",
    ".env.development": "properties",
    ".env.local": "properties",
    ".env.uat": "properties",
    ".env.development.local": "properties",
    ".env.production.local": "properties",
  },
  "files.autoSave": "afterDelay",
  "gitlens.codeLens.enabled": false,
  "gitlens.currentLine.enabled": false,
  "gitlens.hovers.currentLine.over": "line",
  "gitlens.showWhatsNewAfterUpgrades": false,
  "gitlens.views.scm.grouped.views": {
    "commits": true,
    "branches": false,
    "remotes": true,
    "stashes": true,
    "tags": true,
    "worktrees": true,
    "contributors": true,
    "fileHistory": false,
    "repositories": true,
    "searchAndCompare": false,
    "launchpad": false,
  },
  "html.autoClosingTags": true,
  "indentRainbow.colors": [
    "rgba(220, 20, 60, 0.07)",
    "rgba(218, 112, 214, 0.07)",
    "rgba(135, 206, 250, 0.07)",
  ],
  "indentRainbow.includedLanguages": ["python"],
  "js/ts.autoClosingTags.enabled": true,
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "prettier.printWidth": 88,
  "prettier.semi": false,
  "prettier.singleQuote": true,
  "prettier.trailingComma": "es5",
  "rust-analyzer.inlayHints.chainingHints.enable": false,
  "rust-analyzer.inlayHints.closingBraceHints.enable": false,
  "rust-analyzer.inlayHints.parameterHints.enable": false,
  "rust-analyzer.inlayHints.renderColons": false,
  "rust-analyzer.inlayHints.typeHints.enable": false,
  "security.workspace.trust.untrustedFiles": "open",
  "sql-formatter.linesBetweenQueries": 1,
  "sql-formatter.uppercase": true,
  "terminal.external.osxExec": "Ghostty.app",
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "update.showReleaseNotes": false,
  "window.zoomLevel": 0,
  "workbench.editor.empty.hint": "hidden",
  "workbench.startupEditor": "none",
  "workbench.sideBar.location": "right",
  "git.blame.editorDecoration.enabled": false,
  "workbench.productIconTheme": "fluent-icons",
  "workbench.activityBar.compact": true,
  "workbench.activityBar.location": "top",
  "workbench.colorCustomizations": {
    "errorLens.errorForeground": "#a35c5ceb",
    "errorLens.warningForeground": "#d9a962eb",
    "errorLens.infoForeground": "#8db4d6eb",
    "errorLens.hintForeground": "#8db4d6eb",
  },
  "chat.viewSessions.orientation": "stacked",
}
