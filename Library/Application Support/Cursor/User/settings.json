{
  "workbench.colorTheme": "Ayu Dark",
  "editor.fontFamily": "GeistMono Nerd Font",
  "editor.fontSize": 13,
  "terminal.integrated.fontFamily": "GeistMono Nerd Font",
  "terminal.integrated.fontSize": 13,

  "[aspnetcorerazor]": {
    "editor.defaultFormatter": "csharpier.csharpier-vscode",
    "editor.rulers": [120],
    "editor.tabSize": 4
  },
  "[csharp]": {
    "editor.defaultFormatter": "csharpier.csharpier-vscode",
    "editor.rulers": [120],
    "editor.tabSize": 4
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.colorDecorators": false,
    "editor.tabSize": 2
  },
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[scss]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.colorDecorators": false,
    "editor.tabSize": 2
  },
  "[shellscript]": {
    "editor.rulers": [100],
    "editor.tabSize": 2
  },
  "[sql]": {
    "editor.rulers": [100],
    "editor.tabSize": 4
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "[xml]": {
    "editor.tabSize": 2
  },
  "[yaml]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.tabSize": 2
  },
  "breadcrumbs.enabled": true,
  "breadcrumbs.icons": false,
  "codesnap.containerPadding": "1em",
  "codesnap.showWindowControls": false,
  "colorize.colorized_variables": ["CSS", "SASS"],
  "csharpier.enableDiagnostics": false,
  "cSpell.userWords": [
    "afca",
    "anytimefitness",
    "aspnetcore",
    "aspnetcorerazor",
    "autodocs",
    "autohide",
    "blurple",
    "bowser",
    "buildmuscle",
    "burk",
    "camelcase",
    "catppuccin",
    "chartjs",
    "clevertap",
    "clsx",
    "cmdk",
    "codesnap",
    "combobox",
    "comms",
    "cooldown",
    "datepicker",
    "dtos",
    "dynatrace",
    "ENTRA",
    "esbenp",
    "esproj",
    "evolt",
    "falsey",
    "formatjs",
    "ghostty",
    "hiit",
    "kampyle",
    "kettlebells",
    "keyvault",
    "koji",
    "libphonenumber",
    "lightningcss",
    "luxon",
    "medallia",
    "millis",
    "muuv",
    "networkidle",
    "newtonsoft",
    "noda",
    "noninteractive",
    "nvim",
    "nvmrc",
    "offcanvas",
    "orangetheory",
    "paginators",
    "partialize",
    "percburk",
    "poimandres",
    "popout",
    "popperjs",
    "Pressable",
    "quicktime",
    "refetches",
    "regr",
    "rudderstack",
    "searchbox",
    "sebrand",
    "shadcn",
    "sheepdip",
    "signalr",
    "spog",
    "stylesheet",
    "substatus",
    "tanstack",
    "testid",
    "textbox",
    "touchpoint",
    "touchpoints",
    "treeify",
    "trivago",
    "unassigning",
    "vite",
    "whitespaces",
    "Winback",
    "woms",
    "zindex",
    "zustand"
  ],
  "cursor.composer.cmdPFilePicker2": true,
  "cursor.cpp.disabledLanguages": ["scminput"],
  "cursor.cpp.enablePartialAccepts": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "editor.bracketPairColorization.enabled": false,
  "editor.cursorBlinking": "smooth",
  "editor.detectIndentation": false,
  "editor.fontLigatures": false,
  "editor.inlineSuggest.enabled": true,
  "editor.linkedEditing": true,
  "editor.minimap.autohide": true,
  "editor.minimap.enabled": false,
  "editor.snippetSuggestions": "top",
  "errorLens.delay": 3000,
  "errorLens.excludeByMessage": [
    "unknown word.",
    "is assigned a value but never used.",
    "import should occur before import of"
  ],
  "errorLens.fontSize": "-2px",
  "errorLens.messageBackgroundMode": "none",
  "eslint.useFlatConfig": true,
  "explorer.compactFolders": false,
  "explorer.confirmDragAndDrop": false,
  "files.associations": {
    "*.esproj": "xml",
    ".env.staging": "properties",
    ".env.demo": "properties",
    ".env.production": "properties",
    ".env.development": "properties",
    ".env.local": "properties",
    ".env.uat": "properties",
    ".env.development.local": "properties",
    ".env.production.local": "properties"
  },
  "files.autoSave": "afterDelay",
  "gitlens.codeLens.enabled": false,
  "gitlens.currentLine.enabled": false,
  "gitlens.showWhatsNewAfterUpgrades": false,
  "gitlens.views.scm.grouped.views": {
    "branches": false,
    "commits": false,
    "contributors": true,
    "launchpad": false,
    "remotes": true,
    "repositories": false,
    "searchAndCompare": false,
    "stashes": true,
    "tags": true,
    "worktrees": true
  },
  "html.autoClosingTags": true,
  "javascript.autoClosingTags": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "json.schemaDownload.enable": true,
  "npm.packageManager": "pnpm",
  "prettier.semi": false,
  "prettier.singleQuote": true,
  "prettier.trailingComma": "es5",
  "remote.defaultExtensionsIfInstalledLocally": [
    "GitHub.copilot",
    "GitHub.copilot-chat",
    "GitHub.vscode-pull-request-github"
  ],
  "security.promptForLocalFileProtocolHandling": false,
  "security.workspace.trust.untrustedFiles": "open",
  "terminal.external.osxExec": "Ghostty.app",
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.enablePersistentSessions": false,
  "typescript.autoClosingTags": true,
  "typescript.updateImportsOnFileMove.enabled": "always",
  "update.showReleaseNotes": false,
  "window.autoDetectColorScheme": false,
  "window.commandCenter": true,
  "workbench.colorCustomizations": {
    "errorLens.errorForeground": "#a35c5ceb",
    "errorLens.warningForeground": "#d9a962eb",
    "errorLens.infoForeground": "#8db4d6eb",
    "errorLens.hintForeground": "#8db4d6eb"
  },
  "workbench.editor.empty.hint": "hidden",
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.productIconTheme": "fluent-icons",
  "workbench.sideBar.location": "right",
  "workbench.startupEditor": "newUntitledFile",
  "workbench.agentsWindowButton.enabled": false,
  "extensions.installCooldownHours": 72
}
