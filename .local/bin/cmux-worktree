#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  cmux-worktree path <worktree-path>
  cmux-worktree branch <branch-name>
EOF
}

if [[ $# -lt 2 ]]; then
  usage
  exit 2
fi

mode="$1"
value="$2"

case "$mode" in
  path)
    worktree_path="$value"
    ;;
  branch)
    worktree_path="$(git worktree list --porcelain | awk -v branch="refs/heads/$value" '
      $1 == "worktree" { path = substr($0, 10) }
      $1 == "branch" && $2 == branch { print path; found = 1; exit }
      END { if (!found) exit 1 }
    ')" || {
      echo "No worktree found for branch: $value" >&2
      exit 1
    }
    ;;
  *)
    usage
    exit 2
    ;;
esac

if [[ -z "$worktree_path" ]]; then
  echo "Worktree path is empty" >&2
  exit 1
fi

if [[ ! -d "$worktree_path" ]]; then
  echo "Worktree path does not exist: $worktree_path" >&2
  exit 1
fi

worktree_root="$(cd "$worktree_path" && pwd -P)"
workspace_name="$(basename "$worktree_root")"

existing_workspace=""
snapshot_json="$(cmux rpc extension.sidebar.snapshot '{}' 2>/dev/null || true)"

if [[ -n "$snapshot_json" ]]; then
  existing_workspace="$(
    {
      jq -r '
        (.workspaces // [])[]
        | (.ref // .id // "") as $ref
        | (.panel_directories // [])[]?
        | select(type == "string" and length > 0)
        | [$ref, .]
        | @tsv
      ' <<<"$snapshot_json" 2>/dev/null || true
    } |
      while IFS=$'\t' read -r ref cwd; do
        [[ -n "$ref" && -n "$cwd" && -d "$cwd" ]] || continue

        if [[ "$(cd "$cwd" && pwd -P)" == "$worktree_root" ]]; then
          printf '%s\n' "$ref"
          break
        fi
      done
  )"
fi

if [[ -n "$existing_workspace" ]]; then
  cmux select-workspace --workspace "$existing_workspace"
else
  cmux new-workspace --cwd "$worktree_root" --name "$workspace_name" --focus true
fi
