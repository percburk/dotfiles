#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
Usage:
  zellij-worktree path <worktree-path>
  zellij-worktree branch <branch-name>
EOF
}

if [[ $# -lt 2 ]]; then
  usage
  exit 2
fi

mode="$1"
value="$2"

case "$mode" in
path)
  worktree_path="$value"
  ;;
branch)
  worktree_path="$(git worktree list --porcelain | awk -v branch="refs/heads/$value" '
      $1 == "worktree" { path = substr($0, 10) }
      $1 == "branch" && $2 == branch { print path; found = 1; exit }
      END { if (!found) exit 1 }
    ')" || {
    echo "No worktree found for branch: $value" >&2
    exit 1
  }
  ;;
*)
  usage
  exit 2
  ;;
esac

if [[ -z "$worktree_path" ]]; then
  echo "Worktree path is empty" >&2
  exit 1
fi

if [[ ! -d "$worktree_path" ]]; then
  echo "Worktree path does not exist: $worktree_path" >&2
  exit 1
fi

worktree_root="$(cd "$worktree_path" && pwd -P)"
tab_name="$(basename "$worktree_root")"

existing_tab=""
panes_json="$(zellij action list-panes --json --tab --command 2>/dev/null || true)"

if [[ -n "$panes_json" ]]; then
  existing_tab="$(
    {
      jq -r '
        .[]?
        | (.tab_id // "") as $tab_id
        | (.pane_cwd // "") as $cwd
        | select(($tab_id | tostring | length) > 0)
        | select($cwd | type == "string" and length > 0)
        | [$tab_id, $cwd]
        | @tsv
      ' <<<"$panes_json" 2>/dev/null || true
    } |
      while IFS=$'\t' read -r tab_id cwd; do
        [[ -n "$tab_id" && -n "$cwd" && -d "$cwd" ]] || continue

        if [[ "$(cd "$cwd" && pwd -P)" == "$worktree_root" ]]; then
          printf '%s\n' "$tab_id"
          break
        fi
      done
  )"
fi

if [[ -n "$existing_tab" ]]; then
  zellij action go-to-tab-by-id "$existing_tab"
else
  # Supplying an explicit initial shell makes Zellij apply --cwd to the pane
  # reliably; bare `new-tab --cwd ...` can otherwise inherit the focused pane's cwd.
  SHELL=/bin/zsh zellij action new-tab --cwd "$worktree_root" --name "$tab_name" -- /bin/zsh
fi
