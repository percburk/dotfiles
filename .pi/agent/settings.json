{
  "lastChangelogVersion": "0.85.1",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.6-sol",
  "defaultThinkingLevel": "high",
  "hideThinkingBlock": true,
  "quietStartup": false,
  "compaction": {
    "enabled": false
  },
  "terminal": {
    "showImages": true,
    "clearOnShrink": true,
    "showTerminalProgress": false
  },
  "powerline": {
    "preset": "default",
    "placement": "below",
    "welcome": true,
    "disabledSegments": [
      "extension_statuses"
    ]
  },
  "theme": "ayu-dark",
  "tuiMode": "fullscreen",
  "treeFilterMode": "default",
  "collapseChangelog": true,
  "editorPaddingX": 1,
  "packages": [
    "npm:@juanibiapina/pi-extension-settings",
    "npm:pi-web-access",
    "npm:pi-mcp-adapter",
    {
      "source": "npm:@juanibiapina/pi-powerbar",
      "extensions": [
        "-src/powerbar/index.ts",
        "-src/powerbar-tokens/index.ts",
        "-src/powerbar-sub/index.ts",
        "-src/powerbar-provider/index.ts",
        "-src/powerbar-model/index.ts",
        "-src/powerbar-git/index.ts",
        "-src/powerbar-context/index.ts",
        "-node_modules/@juanibiapina/pi-usage/index.ts"
      ]
    },
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-ask-user",
    {
      "source": "npm:@catdaemon/pi-cmux",
      "extensions": [
        "-index.ts"
      ]
    },
    "npm:@juicesharp/rpiv-btw",
    "npm:pi-cursor-sdk",
    "npm:pi-simplify",
    "npm:pi-subagents",
    "npm:pi-powerline-footer"
  ],
  "enabledModels": [
    "cursor/composer-2.5:fast",
    "cursor/sonnet-5@300k",
    "cursor/sonnet-5@1m",
    "openai-codex/gpt-5.6-luna",
    "openai-codex/gpt-5.6-sol",
    "openai-codex/gpt-5.6-terra",
    "cursor/opus-5@1m",
    "cursor/opus-5@300k",
    "openai-codex/gpt-6-astra",
    "cursor/grok-4.6:fast",
    "cursor/grok-4.6:slow",
    "cursor/opus-5@1m:fast",
    "cursor/opus-5@1m:slow",
    "cursor/composer-2.5",
    "cursor/fable-5-1@300k"
  ],
  "autocompleteMaxVisible": 10,
  "fullscreenExitOutput": "resume-hint",
  "fullscreenCopyOnSelect": true,
  "extensions": [
    "-extensions/welcome.ts",
    "+extensions/delta-diff.ts"
  ],
  "workingVibe": "drumming",
  "modelThinkingLevels": {
    "openai-codex/gpt-6-astra": "xhigh",
    "openai-codex/gpt-5.6-sol": "high",
    "openai-codex/gpt-5.6-luna": "xhigh",
    "openai-codex/gpt-5.6-terra": "xhigh"
  }
}