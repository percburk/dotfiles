{
  "lastChangelogVersion": "1.0.1",
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "high",
  "subagents": {
    "defaultModel": "openai-codex/gpt-6.1-sol",
    "defaultProvider": "openai-codex",
    "defaultThinking": "medium",
    "modelScope": {
      "enforce": true,
      "strict": true,
      "allow": [
        "openai-codex/*"
      ]
    },
    "agentOverrides": {
      "scout": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "low",
        "fast": false
      },
      "researcher": {
        "model": "openai-codex/gpt-6-luna",
        "thinking": "medium",
        "fast": false
      },
      "worker": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "medium",
        "fast": false
      },
      "reviewer": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "high",
        "fast": false
      },
      "evidence-auditor": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "high",
        "fast": false
      },
      "delegate": {
        "model": "openai-codex/gpt-6.1-sol",
        "thinking": "medium",
        "fast": false
      },
      "oracle": {
        "model": "openai-codex/gpt-6-astra",
        "thinking": "xhigh",
        "fast": false
      }
    }
  },
  "hideThinkingBlock": true,
  "quietStartup": true,
  "compaction": {
    "enabled": false
  },
  "terminal": {
    "showImages": true,
    "clearOnShrink": true,
    "showTerminalProgress": false
  },
  "powerline": {
    "preset": "default",
    "placement": "below",
    "welcome": false,
    "disabledSegments": [
      "extension_statuses"
    ]
  },
  "theme": "ayu-dark",
  "tuiMode": "fullscreen",
  "treeFilterMode": "default",
  "collapseChangelog": true,
  "editorPaddingX": 1,
  "packages": [
    "npm:@juanibiapina/pi-extension-settings",
    "npm:pi-web-access",
    {
      "source": "npm:@juanibiapina/pi-powerbar",
      "extensions": [
        "-src/powerbar/index.ts",
        "-src/powerbar-tokens/index.ts",
        "-src/powerbar-sub/index.ts",
        "-src/powerbar-provider/index.ts",
        "-src/powerbar-model/index.ts",
        "-src/powerbar-git/index.ts",
        "-src/powerbar-context/index.ts",
        "-node_modules/@juanibiapina/pi-usage/index.ts"
      ]
    },
    "npm:@juicesharp/rpiv-todo",
    "npm:pi-ask-user",
    "npm:pi-cursor-sdk",
    "npm:pi-simplify",
    "npm:pi-subagents",
    {
      "source": "npm:pi-powerline-footer",
      "extensions": [
        "+index.ts"
      ]
    },
    "npm:@narumitw/pi-btw"
  ],
  "enabledModels": [
    "cursor/composer-2.5:fast",
    "openai-codex/gpt-6-astra",
    "cursor/composer-2.5",
    "cursor/fable-5-1@300k",
    "cursor/opus-5.5@300k",
    "cursor/opus-5.5@1m:slow",
    "openai-codex/gpt-6-luna",
    "openai-codex/gpt-6.1-sol",
    "cursor/claude-sonnet-5-5@1m",
    "cursor/claude-sonnet-5-5@300k"
  ],
  "autocompleteMaxVisible": 10,
  "fullscreenExitOutput": "resume-hint",
  "fullscreenCopyOnSelect": true,
  "extensions": [
    "+extensions/delta-diff.ts",
    "+extensions/welcome.ts"
  ],
  "workingVibe": "baking bread",
  "modelThinkingLevels": {
    "openai-codex/gpt-6-luna": "xhigh",
    "openai-codex/gpt-6-astra": "xhigh",
    "cursor/fable-5-1@300k": "xhigh"
  },
  "deviceId": "bc9f2922-6c98-48eb-8636-1a4d807e3917"
}
